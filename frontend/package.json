{
  "name": "wiki-ux",
  "version": "3.0.0",
  "private": true,
  "description": "The most powerful and extensible open source Wiki software",
  "author": "Nicolas Giard <nick@requarks.io>",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vite build --emptyOutDir",
    "ncu": "ncu -i",
    "ncu-u": "ncu -u",
    "icons": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "test": "vitest run",
    "i18n:check": "vitest run src/i18nSourceGate.test.js",
    "install-browsers": "playwright install --with-deps chromium",
    "emoji": "node scripts/generate-emoji.mjs",
    "emoji:check": "node scripts/generate-emoji.mjs --check",
    "locales:check": "node scripts/check-locales.mjs",
    "notify-check": "node scripts/check-notify-err-message.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/vite": "4.3.3",
