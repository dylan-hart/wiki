{
  "name": "cardinal-frontend",
  "version": "3.0.0",
  "private": true,
  "description": "The most powerful and extensible open source Wiki software",
  "author": "Nicolas Giard <nick@requarks.io>",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --mode production --emptyOutDir",
    "ncu": "npx npm-check-updates@23 -i",
    "ncu-u": "npx npm-check-updates@23 -u",
    "icons": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "test": "vitest run",
    "test:flaky": "vitest run --config vitest.flaky.config.js",
    "i18n:check": "vitest run src/i18nSourceGate.test.js",
    "install-browsers": "playwright install --with-deps chromium",
    "favicon": "node scripts/generate-favicon.mjs",
    "emoji": "node scripts/generate-emoji.mjs",
    "emoji:check": "node scripts/generate-emoji.mjs --check",
    "locales:check": "node scripts/check-locales.mjs",
    "notify-check": "node scripts/check-notify-err-message.mjs"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/vite": "4.3.3",
