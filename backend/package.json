{
  "name": "cardinal-backend",
  "version": "3.0.0",
  "private": true,
  "description": "The most powerful and extensible open source Wiki software",
  "keywords": [
    "docs",
    "documentation",
    "guides",
    "knowledge base",
    "markdown",
    "wiki",
    "wikis"
  ],
  "homepage": "https://github.com/requarks/wiki#readme",
  "bugs": {
    "url": "https://github.com/requarks/wiki/issues"
  },
  "license": "AGPL-3.0",
  "author": "Nicolas Giard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/requarks/wiki.git"
  },
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "cd .. && node backend",
    "dev": "cd .. && nodemon backend --watch backend --ext js,ts,json",
    "migrate": "cd .. && node backend/tasks/migrate.ts",
    "verify-migration": "cd .. && node backend/tasks/verify-migration.ts",
    "promote-admin": "cd .. && node backend/tasks/promote-admin.ts",
    "mcp": "cd .. && node backend/mcp/stdio.ts",
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "test": "node --test '**/!(*.flaky).test.ts'",
    "test:flaky": "node --test '**/*.flaky.test.ts'",
    "verify:ci": "bash ../scripts/verify-ci.sh",
    "seed-rtl-test-locale": "node scripts/seed-rtl-test-locale.ts",
    "block-locale-keys": "node scripts/blockLocaleKeys.ts",
    "block-locale-keys:check": "node scripts/blockLocaleKeys.ts --check",
    "ncu": "ncu -i",
    "ncu-u": "ncu -u",
    "db-generate": "drizzle-kit generate --dialect=postgresql --schema=./db/schema.ts --out=./db/migrations --name=main",
    "db-up": "drizzle-kit up --dialect=postgresql --out=./db/migrations"
  },
  "dependencies": {
    "@aws-sdk/client-cloudsearch": "3.1116.0",
    "@aws-sdk/client-cloudsearch-domain": "3.1116.0",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
