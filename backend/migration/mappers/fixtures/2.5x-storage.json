[
  {
    "key": "disk",
    "isEnabled": true,
    "mode": "push",
    "config": {
      "path": "/var/wiki/data",
      "createDailyBackups": true
    },
    "syncInterval": null,
    "state": {}
  },
  {
    "key": "git",
    "isEnabled": true,
    "mode": "sync",
    "config": {
