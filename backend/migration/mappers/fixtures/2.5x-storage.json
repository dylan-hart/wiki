      "verifySSL": true,
      "defaultEmail": "wiki-bot@acme.example.com",
      "defaultName": "Wiki Bot",
      "alwaysNamespace": true
    },
    "syncInterval": "*/15 * * * *",
    "state": {}
  },
  {
    "key": "dropbox",
    "isEnabled": true,
    "mode": "push",
    "config": {
      "accessToken": "fake-dropbox-token",
      "clientId": "dbx-client"
    },
    "syncInterval": null,
    "state": {}
  }
