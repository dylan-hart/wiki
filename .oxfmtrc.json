{
  "$schema": "./backend/node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSameLine": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "backend/db/migrations/**",
    "backend/locales/**",
    "blocks/compiled/**",
    "frontend/src/assets/icons.generated.js",
    "assets/**",
    "frontend/dist/**",
    "frontend/src/assets/*.generated.js",
    "frontend/public/_assets/fonts/**"
  ]
}
